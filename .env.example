# Runtime
NODE_ENV=development
PORT=4000
APP_NAME=Placa na Mão
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# Recuperação de senha: mantenha credenciais somente no runtime do Coolify.
# smtp = envio por SMTP; brevo_api = envio pela API HTTPS do Brevo (porta 443), use se o servidor bloqueia as portas de SMTP (DigitalOcean).
EMAIL_PROVIDER=disabled
# Só com EMAIL_PROVIDER=brevo_api: chave de API do Brevo (SMTP e API > Chaves de API; não é a chave SMTP).
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=no-reply@placanamao.com.br
# Respostas dos e-mails automáticos vão para este endereço (ex.: o Gmail da operação). Vazio = sem Reply-To.
EMAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
TRUST_PROXY=1

# PostgreSQL 17
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_SSL=false
MIGRATION_LOCK_TIMEOUT_MS=60000

# Segurança — gere um segredo aleatório de pelo menos 64 caracteres para cada ambiente.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=2h
# Painel da equipe: segredo de sessão PRÓPRIO (diferente do JWT_SECRET, ≥ 64 caracteres) e 2FA (TOTP) opcional: cada pessoa liga em Minha conta. TEAM_TOTP_REQUIRED=true o torna obrigatório (deixe false).
ADMIN_JWT_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
ADMIN_JWT_EXPIRES_IN=30m
TEAM_TOTP_REQUIRED=false
# Dias em que um computador marcado como confiável não pede o código de novo (0 desliga).
TEAM_TRUSTED_DEVICE_DAYS=90
# Host(s) dedicados ao painel (separados por vírgula) e/ou URL do painel. Em produção ao menos um é obrigatório.
# Exemplo: ADMIN_HOSTS=admin.placanamao.com.br  |  ADMIN_URL=https://admin.placanamao.com.br
ADMIN_HOSTS=
ADMIN_URL=
# Opcional: restrinja o painel a IPs/CIDRs fixos (separados por vírgula).
ADMIN_ALLOWED_IPS=
# Chave que cifra o JSON bruto do provedor e os segredos do 2FA (≥ 32 caracteres; guarde com segurança — perdê-la torna o bruto ilegível).
DATA_ENCRYPTION_KEY=CHANGE_ME_WITH_A_RANDOM_KEY_OF_AT_LEAST_32_CHARACTERS
# Permite à equipe revelar dados pessoais mascarados (motivo obrigatório e auditado).
PII_REVEAL_ENABLED=true
# API pública v1 (integradores). Desligada por padrão.
PUBLIC_API_ENABLED=false
PUBLIC_API_RATE_LIMIT_MAX=60

# Dados veiculares. mock = dados fictícios de teste (proibido em produção); real = provedor contratado (exige as credenciais abaixo);
# disabled = sistema no ar SEM fonte de dados (consultas pagas aparecem como "em breve" e nada é cobrado) — use até contratar o provedor.
DATA_PROVIDER=mock
VEHICLE_API_BASE_URL=
VEHICLE_API_QUERY_PATH=
VEHICLE_API_AUTH_SCHEME=bearer
VEHICLE_API_QUERY_METHOD=get
VEHICLE_API_LOGIN=
VEHICLE_API_PASSWORD=
VEHICLE_API_TOKEN=
VEHICLE_API_DEVICE_TOKEN=
APIBRASIL_BEARER_TOKEN=
APIBRASIL_DEVICE_TOKEN=
VEHICLE_API_TIMEOUT_MS=50000
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600
QUERY_REQUEST_TIMEOUT_MS=60000
# Consultas presas em PROCESSING além deste prazo são estornadas automaticamente.
QUERY_STUCK_MINUTES=10
STORE_RAW_PROVIDER_RESPONSE=true

# FIPE gratuita: habilite somente após validar a documentação e o ambiente.
FEATURE_FREE_FIPE=false
FEATURE_REPORT_PDF=true
FIPE_PRIMARY_BASE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_PRIMARY_TOKEN=
FIPE_SECONDARY_BASE_URL=https://brasilapi.com.br/api
FIPE_SECONDARY_TOKEN=
FIPE_REQUEST_TIMEOUT_MS=10000
FIPE_GUEST_DAILY_LIMIT=3
FIPE_AUTH_DAILY_LIMIT=10
FIPE_CACHE_TTL_DAYS=31

# Provedor de pagamento. Use disabled em produção até o gateway contratado estar homologado.
# Valores aceitos: disabled, sandbox, asaas, mercadopago.
PAYMENT_PROVIDER=sandbox
# Asaas: produção https://api.asaas.com | homologação https://api-sandbox.asaas.com
PAYMENT_API_BASE_URL=
# Asaas — runtime-only; necessária para criar checkout.
PAYMENT_API_KEY=
# Asaas — runtime-only; token enviado no header asaas-access-token.
PAYMENT_WEBHOOK_SECRET=
# URL Asaas: ${APP_URL}/api/payments/asaas/webhook

# Mercado Pago Checkout Pro — runtime-only; nunca commitar ou disponibilizar no frontend.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TIMEOUT_MS=15000
# URL Mercado Pago: ${APP_URL}/api/payments/mercadopago/webhook

# Sandbox. Nunca habilite estes recursos em produção.
SANDBOX_SEED_ENABLED=false
SANDBOX_CREDIT_PURCHASE_ENABLED=false

# Rate limiting, logging e auditoria
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOG_SENSITIVE_DATA=false
AUDIT_LOG_ENABLED=true

# Primeiro administrador criado no startup (só se ainda não existir nenhum SUPER_ADMIN). Senha com 12+ caracteres.
# Entre em ADMIN_URL/ADMIN_HOSTS, cadastre o 2FA e REMOVA ADMIN_BOOTSTRAP_PASSWORD do ambiente em seguida.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador
# Recuperação de acesso: redefine a senha (e zera o 2FA) do e-mail acima mesmo que já exista administrador. Use uma vez e remova.
ADMIN_BOOTSTRAP_FORCE_RESET=false

# Bootstrap administrativo pontual; mantenha desligado após a promoção auditada.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_EMAIL=

# Autenticação social OIDC — configure segredos somente em runtime, nunca no repositório ou no build.
# Redirect URIs autorizadas: ${APP_URL}/api/auth/oauth/google/callback
#                           ${APP_URL}/api/auth/oauth/microsoft/callback
#                           ${APP_URL}/api/auth/oauth/apple/callback
OAUTH_STATE_TTL_SECONDS=600
OAUTH_LOGIN_TICKET_TTL_SECONDS=120

# Google OAuth 2.0 (aplicação Web)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (registro de aplicativo Web; tenant=common aceita contas pessoais e corporativas)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# Sign in with Apple — armazene a chave privada com quebras como \n no segredo do runtime.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# Simulador de financiamento: atualiza as taxas pelo Banco Central a cada 24 h. Use false para desligar (as taxas ficam como estão no painel).
FINANCING_AUTO_REFRESH=true

# ---- 1.10.0: integrações preparadas (tudo desligado por padrão; nada de segredo no repositório) ----
# Fonte das consultas veiculares quando DATA_PROVIDER=real: generic | credify | consultarplaca
VEHICLE_API_PROVIDER=generic
# Tipos de busca além da placa que o contrato atende (Credify ou genérico): CHASSIS,RENAVAM,OWNER_DOC. O modelo de corpo/caminho precisa ter {{chassis}}, {{renavam}} ou {{document}}.
VEHICLE_SEARCH_TYPES=PLATE
CREDIFY_BASE_URL=
CREDIFY_CLIENT_ID=
CREDIFY_CLIENT_SECRET=
# Padrão: /veiculototal (consulta Veículo Total). Só preencha se a Credify mandar outro caminho.
CREDIFY_QUERY_PATH=
# Código fixo (IdConsulta) da consulta. Vazio = usa o código padrão do caminho (467 Veículo Total, 487 Débitos/Restrições/Proprietários, 369 BNacional, 370 Renavam, 486 Agregados, 587 Flag CNH, 536 Renainf, 475 Veículo por Documento, 450 Indício de Sinistro, 448 Leilão Conjugado, 533 Gravame, 514 Veículo Proprietário Placa, 510 Veículo Documento Frota). Sem código publicado na documentação (pedir à Credify): Recall, Farol Leilão, Precificador Fipe, Histórico Roubo e Furto, ATPVe, Renajud, Renavam Online, Histórico de Proprietários. O Veículo Total (467) já traz recall, roubo/furto, leilão, sinistro, proprietários, FIPE, cadastro e débitos/restrições numa só chamada.
CREDIFY_QUERY_ID=
CREDIFY_QUERY_METHOD=post
# Opcional. Padrão: {"Consulta":{"IdConsulta":"{{queryId}}","Placa":"{{plate}}"}}. Aceita {{plate}} e {{queryId}}.
CREDIFY_QUERY_BODY_TEMPLATE=

# ConsultarPlaca (para testes): VEHICLE_API_PROVIDER=consultarplaca. Placa de teste AAA0000 não gasta crédito.
CONSULTARPLACA_BASE_URL=
CONSULTARPLACA_EMAIL=
CONSULTARPLACA_API_KEY=

# Consulta de CNPJ no servidor: disabled | brasilapi
CNPJ_PROVIDER=disabled
CNPJ_BASE_URL=
CNPJ_API_TIMEOUT_MS=8000
CNPJ_CACHE_TTL_HOURS=24

# Fila de e-mail e links seguros
# Brevo (SMTP): EMAIL_PROVIDER=smtp, SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587 (SMTP_SECURE=false) ou 465 (SMTP_SECURE=true),
# SMTP_USER = login SMTP exibido em Brevo > SMTP e API, SMTP_PASSWORD = chave SMTP (não a chave de API),
# EMAIL_FROM = remetente/domínio validado no Brevo. Webhook: ver PENDENCIAS-PRODUCAO.md.
EMAIL_OUTBOX_WORKER=true
EMAIL_MAX_ATTEMPTS=6
SECURE_LINK_TTL_HOURS=72
EMAIL_WEBHOOK_SECRET=

# Contratos e fiscal: disabled | internal (assinatura) ; disabled | manual (fiscal; mock só em testes)
ESIGN_PROVIDER=disabled
ESIGN_WEBHOOK_SECRET=
FISCAL_PROVIDER=disabled

# Mercado Pago (opcionais além de MP_ACCESS_TOKEN/MP_WEBHOOK_SECRET)
MP_API_BASE_URL=
MP_EXPIRES_MINUTES=0
MP_STATEMENT_DESCRIPTOR=
MP_BINARY_MODE=false
# Confere pedidos abertos no Mercado Pago a cada 3 minutos (rede de segurança do webhook)
PAYMENT_SYNC_WORKER=true

# Loja (estoque, leads, vitrine): limites iniciais de cada loja nova; o painel admin ajusta por loja
DEALER_DEFAULT_VEHICLE_LIMIT=30
DEALER_DEFAULT_MEMBER_LIMIT=3


# Pré-lançamento: site fechado ao público. Sem indexação (robots, sitemap, cabeçalho e meta) e só estes
# e-mails (ou @domínios, separados por vírgula) criam conta, pagam e consultam. Para abrir: SITE_MODE=public.
SITE_MODE=public
PRELAUNCH_ALLOWED_EMAILS=

# Atendimento: aparecem no rodapé, em Contato, no Suporte e dentro do contrato de cada compra.
# Deixe vazio o que não existir. SUPPORT_EMAIL precisa ser um e-mail que recebe mensagens.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=
# Dados da empresa para o contrato de compra: só valem se Admin > Notas fiscais estiver sem razão social e CNPJ.
COMPANY_LEGAL_NAME=
COMPANY_CNPJ=
COMPANY_ADDRESS=

# Dado bruto do fornecedor (cifrado): dias até apagar. 0 = não apaga. Sugestão: 90.
# O relatório que o cliente vê não é afetado.
RAW_RETENTION_DAYS=0
